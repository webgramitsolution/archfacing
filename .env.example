# ─── पहला Super Admin (seed बनाएगा) ────────────────────────
SEED_SUPERADMIN_MOBILE="9667987129"
SEED_SUPERADMIN_EMAIL="admin@archfacing.com"
SEED_SUPERADMIN_PASSWORD="ChangeMe@123"

# ─── Email — Hostinger SMTP (OTP यहीं से जाता है) ──────────
# hPanel → Emails → mailbox बनाइए, फिर यहाँ भरिए।
# खाली छोड़ेंगे तो OTP terminal में print होगा (dev mode) —
# SMTP सेट किए बिना भी पूरा registration test कर सकते हैं।
SMTP_HOST="smtp.hostinger.com"
SMTP_PORT="465"
SMTP_USER=""
SMTP_PASS=""
EMAIL_FROM="ArchFacing <noreply@archfacing.com>"

# ─── Cron (PACT रखरखाव) ─────────────────────────────────────
