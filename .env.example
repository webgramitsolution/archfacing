# ─── Storage — Cloudflare R2 (Phase 3) ─────────────────────
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET="archfacing"
